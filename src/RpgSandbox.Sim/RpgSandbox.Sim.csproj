<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Engine-level tests stage exact orderings of events that are hard to reach through the public API. -->
    <InternalsVisibleTo Include="RpgSandbox.Sim.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- D1a: the default content pack, compiled in from game/content/ (the files stay where Godot can see them too). -->
    <EmbeddedResource Include="..\..\game\content\**\*.json" LogicalName="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

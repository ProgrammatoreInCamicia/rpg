<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Public packages (xunit, ...). Listed explicitly: some machines have no nuget.org source configured. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Godot .NET SDK packages shipped with the portable editor (see README). -->
    <add key="GodotLocal" value="tools/godot/Godot_v4.7.2-stable_mono_win64/GodotSharp/Tools/nupkgs" />
  </packageSources>
</configuration>
